# ── LLM provider (OpenAI-compatible) ──────────────────────────────────────────
# Writes place descriptions for POIs that aren't in Wikipedia. OPTIONAL: without
# it the app uses varied per-type templates. Provider-agnostic via LLM_*.
# Recommended: Google Gemini free tier (no credit card). Use a CURRENT model —
# gemini-flash-latest is an alias that stays valid (older ids like gemini-2.5-flash
# are 404/blocked for new keys). Alt (pinned): gemini-3.5-flash.
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_google_ai_studio_key
LLM_MODEL=gemini-flash-latest
# Legacy Nebius fallback — used only if the LLM_* vars above are unset:
# NEBIUS_API_KEY=your_nebius_api_key_here
# NEBIUS_API_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# ── Database (required) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Optional integrations ─────────────────────────────────────────────────────
# Google Places: real photos/ratings/hours, Restaurantes tab, city autocomplete
GOOGLE_PLACES_API_KEY=your_google_places_key
GOOGLE_PLACES_DAILY_BUDGET_USD=6
# OpenRouteService routing (free 2000/day); without it falls back to OSRM demos
ORS_API_KEY=your_ors_key
# Auth0 login (the app works without it)
AUTH0_DOMAIN=your_auth0_domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_AUDIENCE=https://your-api-identifier

# Affiliate activity sections. With neither id set, nothing affiliate renders.
# The server reads either name; the client only the VITE_ ones (build time).
# CIVITATIS_AID=your_civitatis_aid
# GYG_PARTNER_ID=your_getyourguide_partner_id

# ── Client build-time (Vite) ──────────────────────────────────────────────────
# Read by Vite during `npm run build`, NOT at runtime: setting them on a running
# server does nothing, the build has to be redone.
# Umami analytics (cookieless); without it analytics no-ops
VITE_UMAMI_WEBSITE_ID=your_umami_website_id
# Only when self-hosting Umami; defaults to https://cloud.umami.is/script.js
# VITE_UMAMI_SRC=
# VITE_CIVITATIS_AID=your_civitatis_aid
# VITE_GYG_PARTNER_ID=your_getyourguide_partner_id

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Which row of api_spend this process owns. SET THIS TO local IN DEVELOPMENT:
# the DATABASE_URL above may well be the production database, and without a
# separate scope a local run spends production's daily Google allowance.
API_SPEND_SCOPE=local

# Comma-separated origins allowed by CORS. Unset = production domain + localhost.
# CORS_ALLOWED_ORIGINS=https://randomtripgenerator.com

# Comma-separated Overpass instances, in order of preference. Unset = the main
# instance plus overpass.openstreetmap.fr as a hedge. Useful to reorder them if
# one starts rate-limiting the server's IP.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
